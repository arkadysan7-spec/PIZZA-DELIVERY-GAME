# --- מודל תמונה (לפחות אחד) ---
# Nano Banana Pro (Gemini 3 Pro Image) – תומך 2K מקורי. ברירת מחדל.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GPT Image (OpenAI)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# auto | 1024x1536 | 1536x1024 | 2048x1536 ... (אם המודל תומך)
OPENAI_IMAGE_SIZE=auto
# gemini | openai – איזה ספק כשהלקוח לא בחר
DEFAULT_PROVIDER=gemini

# --- קטלוג ---
# כתובת אתר העסק. ריק = קטלוג הדגמה
CATALOG_URL=
# מארחי תמונות נוספים מותרים (CDN), מופרדים בפסיק
ALLOWED_IMAGE_HOSTS=

# --- אבטחה ---
# קוד גישה לאפליקציה (מונע שימוש זר בקרדיט של ה-API). מומלץ מאוד.
APP_ACCESS_CODE=

# --- אחסון ענן (אופציונלי) ---
# Vercel Blob: מאפשר קישור לתמונה בוואטסאפ + גיבוי ההדמיות
BLOB_READ_WRITE_TOKEN=
